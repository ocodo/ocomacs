;;; Config your preferred font and font-size
;;; Defaults to NotoSansMono

(defvar ocomacs-personal-mono-font
  (font-spec
   :family "NotoSansMono"
   :weight 'light)
  "Personal default monospaced - font spec - Nerd Fonts recommended")

(defvar ocomacs-preferred-font-height
  160 "size in 1/10pt")
